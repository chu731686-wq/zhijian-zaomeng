# 管理员账号，首次启动会自动创建。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=infinite-canvas

# JWT 登录密钥和过期时间，正式部署请修改 JWT_SECRET。
JWT_SECRET=infinite-canvas
JWT_EXPIRE_HOURS=168

# 用户模型配置中的 API 密钥加密密钥；生产部署请设置并妥善备份，丢失后已存密钥无法解开。
# 留空时从 JWT_SECRET 派生。
CONFIG_ENCRYPTION_KEY=

# 后端默认监听 8080，如需本地开发修改端口再取消注释。
# Docker 镜像内前端固定监听 3000，避免覆盖前端 PORT。
# PORT=8080

# 前端开发代理默认使用 http://127.0.0.1:8080，如后端开发端口不同，启动前端时可单独设置 API_BASE_URL。
# API_BASE_URL=http://127.0.0.1:8080

# 数据库配置，默认使用本地 SQLite。
STORAGE_DRIVER=sqlite
# sqlite: DATABASE_DSN=data/infinite-canvas.db

# Docker 部署时建议使用绝对路径，避免工作目录变化后写入临时库：DATABASE_DSN=/app/data/infinite-canvas.db
# mysql 目标库不存在时会尝试自动创建，账号需有 CREATE 权限。
# mysql: DATABASE_DSN=user:password@tcp(127.0.0.1:3306)/infinite_canvas?parseTime=true
# postgres 目标库不存在时会尝试自动创建，账号需有 CREATEDB 权限。
# postgres: DATABASE_DSN=postgres://user:password@127.0.0.1:5432/infinite_canvas?sslmode=disable
DATABASE_DSN=data/infinite-canvas.db

# 默认私有媒体存储；与数据库一起备份。Docker 默认 /app/data/uploads。
UPLOAD_DIR=data/uploads

# 注册默认需要管理员生成的一次性邀请码；false 可关闭要求。
REGISTRATION_INVITE_REQUIRED=true

# 邮件验证码 SMTP。HOST 或 FROM 未填写时不发送邮件，验证码仅打印到后端日志。
# 页面会提示“邮件服务还没配置，请联系管理员”。验证码 10 分钟有效，60 秒内不能重发。
SMTP_HOST=
# 587 使用 STARTTLS；465 使用隐式 TLS；本机邮件调试服务可使用未加密连接。
SMTP_PORT=587
# 无需认证的邮件中继可留空；需要认证时填写账号和密码/授权码。
SMTP_USER=
SMTP_PASS=
# 发件人邮箱，例如 noreply@example.com。
SMTP_FROM=

# Render 免费版禁 SMTP，线上用 Brevo。
BREVO_API_KEY=
# Brevo 需手机验证时可改用 Mailjet。
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM=
MAIL_FROM_NAME=指尖造梦

# Google OAuth：三项都配置好后启用登录；无需安装额外依赖。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 必须与 Google 控制台授权回调一致，指向前端域名的后端代理路径。
# 本机示例：http://localhost:3000/api/auth/google/callback；生产必须使用 HTTPS。
GOOGLE_REDIRECT_URL=
