# 管理员首次登录密码。首次上线前换成自己保管的强密码；可用下面命令生成随机密码。
# openssl rand -base64 24
ADMIN_PASSWORD=请替换为随机密码

# 登录会话签名密钥。用命令生成后粘贴；以后不要更换，否则现有登录会失效。
# openssl rand -hex 32
JWT_SECRET=请替换为随机密钥

# 用户模型 API 密钥的加密密钥。用命令生成并单独备份；丢失后已保存的密钥无法解开。
# openssl rand -hex 32
CONFIG_ENCRYPTION_KEY=请替换为随机密钥

# 网站域名，不带 https://，例如 canvas.example.com；先在域名服务商处把域名 A 记录指向服务器公网 IP。
SITE_DOMAIN=请替换为你的域名

# 邮件服务器地址：用于发送注册和找回密码验证码；从邮件服务商的 SMTP 设置页获取。
SMTP_HOST=
# 邮件服务器端口：服务商通常提供 587（加密发送）或 465（SSL/TLS），按服务商说明填写。
SMTP_PORT=587
# 邮件登录账号：从邮件服务商获取；服务商不要求认证时可留空。
SMTP_USER=
# 邮件登录密码或专用授权码：从邮件服务商获取；不要使用个人邮箱登录密码，免认证时留空。
SMTP_PASS=
# 发件人邮箱：需在邮件服务商验证，例如 noreply@example.com。
SMTP_FROM=

# Google 登录客户端 ID：在 Google Cloud Console 创建 OAuth 网页应用后复制。
GOOGLE_CLIENT_ID=
# Google 登录客户端密钥：在同一 OAuth 网页应用的凭据页复制，按密码保管。
GOOGLE_CLIENT_SECRET=
# Google 登录回调地址：在 OAuth 设置和这里填写同一个地址，域名替换成 SITE_DOMAIN。
GOOGLE_REDIRECT_URL=https://请替换为你的域名/api/auth/google/callback

# 是否要求新用户提供管理员生成的邀请码；true 表示需要，建议保留。
REGISTRATION_INVITE_REQUIRED=true
